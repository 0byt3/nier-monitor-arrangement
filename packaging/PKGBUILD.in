pkgname=nier-monitor-arrangement
pkgver=0.1.0
pkgrel=2
pkgdesc='Standalone Quickshell display arrangement editor with saved Hyprland profiles'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('bash' 'quickshell' 'hyprland>=0.55' 'lua' 'qt6-declarative')
makedepends=('go')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off CGO_ENABLED=0
  bash bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off CGO_ENABLED=0 go test ./...
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local assets="$pkgdir/usr/share/nier/plugins/nier.monitor-arrangement"
  install -d "$assets/i18n" "$pkgdir/usr/bin"
  install -m644 qml/shell.qml qml/Editor.qml qml/Theme.qml qml/Strings.qml hypr/runtime.lua "$assets/"
  install -m644 qml/i18n/*.json "$assets/i18n/"
  install -Dm755 build/nier-monitor-arrangement-backend "$pkgdir/usr/share/nier/bin/nier-monitor-arrangement-backend"
  install -Dm755 bin/nier-monitor-arrangement "$pkgdir/usr/share/nier/bin/nier-monitor-arrangement"
  install -Dm755 bin/enable-hyprland "$pkgdir/usr/share/nier/bin/nier-monitor-arrangement-enable"
  ln -s /usr/share/nier/bin/nier-monitor-arrangement "$pkgdir/usr/bin/nier-monitor-arrangement"
  ln -s /usr/share/nier/bin/nier-monitor-arrangement-enable "$pkgdir/usr/bin/nier-monitor-arrangement-enable"
  install -Dm644 packaging/nier-monitor-arrangement.svg "$assets/nier-monitor-arrangement.svg"
  install -d "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  ln -s /usr/share/nier/plugins/nier.monitor-arrangement/nier-monitor-arrangement.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/nier-monitor-arrangement.svg"
  install -Dm644 packaging/nier-monitor-arrangement.desktop "$pkgdir/usr/share/applications/nier-monitor-arrangement.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
